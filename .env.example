# =============================================================================
# XAUUSD Gold Scalper Bot — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to GitHub (it's in .gitignore).
# On Railway, add these as environment variables in Settings → Variables.
# =============================================================================

# --- TradingView Session Cookies ---
# HOW TO GET: Open Chrome → tradingview.com → F12 → Application tab →
#             Cookies → tradingview.com → copy 'sessionid' value
TV_SESSION=your_tradingview_sessionid_cookie_here

# HOW TO GET: Same location as above → copy 'sessionid_sign' value
TV_SESSION2=your_tradingview_sessionid_sign_cookie_here

# --- TradingView Paper Trading Account ---
# HOW TO GET: In DevTools Network tab → click Paper Trading panel →
#             find any API request → look for 'id' field starting with 'pst'
TV_ACCOUNT_ID=pst_your_account_id_here

# --- Webhook Security ---
# Must match the 'secret' field in TradingView alert JSON messages.
# Change to any strong value — just keep it consistent everywhere.
WEBHOOK_SECRET=mysecret123

# --- Trade Configuration ---
# 0.05 lots = ~$200 margin on XAUUSD at 1:100 leverage
TRADE_SIZE=0.05

# --- Gemini API Key (used by Antigravity agents) ---
# HOW TO GET: Go to aistudio.google.com → Get API Key → Create API Key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# --- Railway Server URL (set after deployment) ---
# HOW TO GET: Deploy to Railway → Settings → Networking → Generate Domain
# Used by the Order Executor agent to call this server's /webhook endpoint
RAILWAY_URL=https://your-app-name.up.railway.app
